# Description: Example of .env file
# Usage: Duplicate this file as .env and change as needed.

# MongoDB URI (optional; dev and tests fall back to an in-memory MongoDB).
MONGO_URI=mongodb://localhost:27018/template-api

# Optional: dedicated database for full-app MongoDB tests. Never use the app DB.
# MONGO_TEST_URI=mongodb://localhost:27018/template-api-test

# Skip token verification entirely (local development / tests).
AUTH_SKIP=false

# IANA timezone for timetable/calendar features (default: Asia/Hong_Kong).
# APP_TIMEZONE=Asia/Hong_Kong

# Optional: sign paginated cursors. Required in production; use at least 32
# random bytes and keep it stable across restarts and API instances.
# CURSOR_SIGNING_KEY=
# CURSOR_TTL_SECONDS=900
# RECURRENCE_MAX_SPAN_DAYS=1461
# IDEMPOTENCY_RETENTION_SECONDS=86400

# Calendar safety limits and Time Banner lookahead.
# CALENDAR_MAX_WINDOW_DAYS=366
# CALENDAR_MAX_ITEMS=1000
# CALENDAR_MAX_CONFLICTS=10000
# TIME_BANNER_UPCOMING_HOURS=24

# Academic reads use the active imported batch. Only stale section quotas
# enqueue refresh jobs; run the separate worker against the same MongoDB.
# ACADEMIC_STRUCTURE_TTL_SECONDS=86400
# ACADEMIC_CURRENT_TERM_CODE=2610
# ACADEMIC_QUOTA_TTL_SECONDS=900
# ACADEMIC_QUOTA_MIN_INTERVAL_SECONDS=300
# REFRESH_FAILURE_COOLDOWN_SECONDS=3600
# REFRESH_MAX_ATTEMPTS=3
# REFRESH_LEASE_SECONDS=60
# ACADEMIC_PROVIDER_BASE_URL=https://w5.ab.ust.hk/wcq/cgi-bin

# Host port used by docker compose for the API.
# API_PORT=3000
